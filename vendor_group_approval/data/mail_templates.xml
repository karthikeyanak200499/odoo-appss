        <record id="mail_template_vendor_rejected" model="mail.template">
            <field name="name">Vendor Rejected - Notification</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="subject">Vendor Rejected: {{ object.name }}</field>
            <field name="email_from">{{ user.email_formatted or '' }}</field>

            <field name="body_html" type="html">
                <div style="font-family:Arial, Helvetica, sans-serif; font-size:14px; color:#333;">

                    <p>Dear Team,</p>

                    <p>
                        We regret to inform you that the following vendor request has not been approved
                        and has been marked as rejected in the system.
                    </p>

                    <table style="border-collapse:collapse; margin-top:10px;">
                        <tr>
                            <td style="padding:6px 10px;">
                                <b>Vendor Name</b>
                            </td>
                            <td style="padding:6px 10px;">:
                                <t t-out="object.name or ''"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding:6px 10px;">
                                <b>Company</b>
                            </td>
                            <td style="padding:6px 10px;">:
                                <t t-out="user.company_id.name or ''"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding:6px 10px;">
                                <b>Approval Status</b>
                            </td>
                            <td style="padding:6px 10px;">:
                                <t t-out="object.vendor_approval_state or ''"/>
                            </td>
                        </tr>
                    </table>

                    <p style="margin-top:20px;">
                        You may review the vendor details and approval status in the system by clicking the button
                        below.
                    </p>

                    <p>
                        <a t-att-href="object.get_res_partner_url()"
                           style="background-color:#C62828;
                          color:#ffffff;
                          padding:10px 16px;
                          text-decoration:none;
                          border-radius:6px;
                          font-weight:bold;">
                            View Vendor Details
                        </a>
                    </p>

                    <p style="margin-top:20px;">
                        Should you require further clarification or wish to revisit the vendor request,
                        please coordinate with the concerned approval authority or procurement team.
                    </p>

                    <p>
                        Kind Regards,
                        <br/>
                        <b>
                            <t t-out="user.name or ''"/>
                        </b>
                        <br/>
                        <t t-out="user.company_id.name or ''"/>
                    </p>

                    <hr style="margin-top:20px;"/>

                    <p style="font-size:12px; color:#777;">
                        This is an automated notification generated by the Vendor Approval Workflow System.
                        Please do not reply directly to this email.
                    </p>

                </div>
            </field>
        </record>

