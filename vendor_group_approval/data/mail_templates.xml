        <record id="mail_template_vendor_final_approved" model="mail.template">
            <field name="name">Vendor Approved - Notification</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="subject">Vendor Approved: {{ object.name }}</field>
            <field name="email_from">{{ user.email_formatted or '' }}</field>

            <field name="body_html" type="html">
                <div style="font-family:Arial, Helvetica, sans-serif; font-size:14px; color:#333;">

                    <p>Dear Team,</p>

                    <p>
                        We are pleased to inform you that the following vendor has successfully completed the
                        approval process and is now authorized for business engagement.
                    </p>

                    <table style="border-collapse:collapse; margin-top:10px;">
                        <tr>
                            <td style="padding:6px 10px;">
                                <b>Vendor Name</b>
                            </td>
                            <td style="padding:6px 10px;">:
                                <t t-out="object.name or ''"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding:6px 10px;">
                                <b>Approved By Company</b>
                            </td>
                            <td style="padding:6px 10px;">:
                                <t t-out="user.company_id.name or ''"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding:6px 10px;">
                                <b>Approval Status</b>
                            </td>
                            <td style="padding:6px 10px;">:
                                <t t-out="object.vendor_approval_state or ''"/>
                            </td>
                        </tr>
                    </table>

                    <p style="margin-top:20px;">
                        You may review the vendor details in the system by clicking the button below.
                    </p>

                    <p>
                        <a t-att-href="object.get_res_partner_url()"
                           style="background-color:#2E7D32;
                          color:#ffffff;
                          padding:10px 16px;
                          text-decoration:none;
                          border-radius:6px;
                          font-weight:bold;">
                            View Vendor Details
                        </a>
                    </p>

                    <p style="margin-top:20px;">
                        Should you require any further information or clarification,
                        please feel free to contact the procurement or administration team.
                    </p>

                    <p>
                        Kind Regards,
                        <br/>
                        <b>
                            <t t-out="user.name"/>
                        </b>
                        <br/>
                        <t t-out="user.company_id.name"/>
                    </p>

                    <hr style="margin-top:20px;"/>

                    <p style="font-size:12px;color:#777;">
                        This message was automatically generated by the Vendor Approval Workflow System.
                        Please do not reply directly to this email.
                    </p>

                </div>
            </field>
        </record>

