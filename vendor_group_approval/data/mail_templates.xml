        <record id="mail_template_vendor_stage_request" model="mail.template">
            <field name="name">Vendor Approval - Action Required</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="subject">Vendor Approval Request: {{ object.name }}</field>
            <field name="email_from">{{ user.email_formatted or '' }}</field>

            <field name="body_html" type="html">
                <div style="font-family:Arial, Helvetica, sans-serif; font-size:14px; color:#333;">

                    <p>Dear Approver,</p>

                    <p>
                        A new <b>Vendor Approval Request</b> has been submitted and requires your review.
                        Please review the vendor details below and proceed with the approval process.
                    </p>

                    <table style="border-collapse:collapse; margin-top:10px;">
                        <tr>
                            <td style="padding:6px 10px;">
                                <b>Vendor Name</b>
                            </td>
                            <td style="padding:6px 10px;">:
                                <t t-out="object.name or ''"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding:6px 10px;">
                                <b>Company</b>
                            </td>
                            <td style="padding:6px 10px;">:
                                <t t-out="user.company_id.name or ''"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding:6px 10px;">
                                <b>Approval Level</b>
                            </td>
                            <td style="padding:6px 10px;">:
                                <t t-out="object.vendor_current_approval_level_id.name or ''"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding:6px 10px;">
                                <b>Status</b>
                            </td>
                            <td style="padding:6px 10px;">:
                                <t t-out="object.vendor_approval_state or ''"/>
                            </td>
                        </tr>
                    </table>

                    <p style="margin-top:20px;">
                        Please click the button below to review the vendor request in the system:
                    </p>

                    <p>
                        <a t-att-href="object.get_res_partner_url()"
                           style="background-color:#875A7B;
                          color:#ffffff;
                          padding:10px 16px;
                          text-decoration:none;
                          border-radius:6px;
                          font-weight:bold;">
                            View Vendor Approval Request
                        </a>
                    </p>

                    <p style="margin-top:20px;">
                        If you require additional information, please contact the procurement team.
                    </p>

                    <p>
                        Best Regards,
                        <br/>
                        <b>
                            <t t-out="user.name"/>
                        </b>
                        <br/>
                        <t t-out="user.company_id.name"/>
                    </p>

                    <hr style="margin-top:20px;"/>

                    <p style="font-size:12px;color:#777;">
                        This is an automated notification from the Vendor Approval Workflow.
                        Please do not reply directly to this email.
                    </p>

                </div>
            </field>
        </record>

