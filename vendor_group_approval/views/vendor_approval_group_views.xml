<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_vendor_approval_group_tree" model="ir.ui.view">
            <field name="name">vendor.approval.group.tree</field>
            <field name="model">vendor.approval.group</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="sequence"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="view_vendor_approval_group_form" model="ir.ui.view">
            <field name="name">vendor.approval.group.form</field>
            <field name="model">vendor.approval.group</field>
            <field name="arch" type="xml">
                <form string="Vendor Approval Group">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="company_id"/>
                        </group>

                        <notebook>
                            <page string="Approval Levels">
                                <field name="level_ids">
                                    <tree editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="user_ids" widget="many2many_tags"/>
                                         <field name="company_id"/>
                                        <field name="active"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>
